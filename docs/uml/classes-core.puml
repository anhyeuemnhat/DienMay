@startuml
skinparam classAttributeIconSize 0
interface ApiGateway { +call(operation, bearer, body) }
class HttpApiClient
HttpApiClient ..|> ApiGateway
class AppContext
class MakeSaleUI
class SaleController { -pending : SaleRequest\n+submit()\n+retry()\n+resolve()\n+cancel() }
class StockController
class PendingStore { +save()\n+sale()\n+inventory()\n+clear()\n+close() }
class Cart { -lines\n+add()\n+remove()\n+lines()\n+subtotal() }
class ItemQuantity <<record>>
class Item <<record>>
class SaleRequest <<record>> { +fingerprint() }
class InventoryRequest <<record>> { +fingerprint() }
class Sale <<record>>
AppContext o-- ApiGateway
MakeSaleUI --> AppContext
MakeSaleUI *-- SaleController
MakeSaleUI *-- Cart
Cart o-- ItemQuantity
Cart --> Item
SaleController --> ApiGateway
SaleController *-- PendingStore
SaleController --> SaleRequest
SaleController --> Sale
StockController --> ApiGateway
StockController *-- PendingStore
StockController --> InventoryRequest
interface ApiHandler { +execute(operation, bearer, input) }
class ApplicationApi
class ApiServer
class InventorySystem
class AuthService
class SalesService
class InventoryService
class CatalogService
class PeopleService
class PromotionService
class WarrantyService
class ReportService
class SqlDatabase { +read(work)\n+transaction(work) }
class ProductDao
class StockDao
class InvoiceDao
class RequestCancellationDao
ApplicationApi ..|> ApiHandler
ApiServer o-- ApiHandler
ApplicationApi --> InventorySystem
InventorySystem *-- AuthService
InventorySystem *-- SalesService
InventorySystem *-- InventoryService
InventorySystem *-- CatalogService
InventorySystem *-- PeopleService
InventorySystem *-- PromotionService
InventorySystem *-- WarrantyService
InventorySystem *-- ReportService
InventorySystem o-- SqlDatabase
SalesService --> SqlDatabase
SalesService --> AuthService
SalesService --> ProductDao
SalesService --> StockDao
SalesService --> InvoiceDao
SalesService --> RequestCancellationDao
InventoryService --> StockDao
InventoryService --> ProductDao
InventoryService --> RequestCancellationDao
AuthService --> SqlDatabase
HttpApiClient ..> ApiServer : HTTPS/JSON between JVMs
note bottom
Core diagram deliberately omits utility/nested classes.
Source inventory lists all delivered top-level Java files.
end note
@enduml
