digraph Deployment {
 graph [rankdir=LR,bgcolor="white",pad="0.35",nodesep="0.6",ranksep="0.7",fontname="DejaVu Sans",label="DienMay | Independent deployment tiers",labelloc=t,fontsize=22];
 node [shape=box,style="rounded,filled",fillcolor="#edf3fa",color="#35516f",fontname="DejaVu Sans",fontsize=13,margin="0.25,0.18"];
 edge [fontname="DejaVu Sans",fontsize=11,color="#35516f"];
 client [label="TIER 1 | Desktop JVM\nAppContext + Swing views\nHttpApiClient\nclient-swing.jar + common-dto.jar\nNo SQL driver or DB credentials"];
 backend [label="TIER 2 | Application JVM\nApiServer -> ApplicationApi\nAuthService + business services\nSqlDatabase + JDBC DAOs\nbackend-server.jar + common-dto.jar"];
 db [shape=cylinder,fillcolor="#f4f1e7",label="TIER 3 | SQL Server\ndm schema: 20 baseline tables\n+ RequestCancellations (v2)\nConstraints / stock ledger / transactions"];
 client -> backend [label="HTTPS / JSON\nopaque bearer token"];
 backend -> db [label="JDBC over SQL Server TCP/TLS\nbackend-only credentials"];
 note [shape=note,fillcolor="#fff4dd",label="Evidence boundary\nHTTP and Swing tested with fixtures.\nReal SQL Server / Windows / multi-host TLS NOT run."];
 backend -> note [style=dotted,arrowhead=none];
}
