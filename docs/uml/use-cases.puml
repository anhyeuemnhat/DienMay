@startuml
left to right direction
actor Manager as M
actor Cashier as C
actor Warehouse as W
rectangle DienMay {
 usecase "Login / change password / logout" as Auth
 usecase "Read product / available stock" as Products
 usecase "Manage products / categories / brands" as Catalog
 usecase "Customers" as Customer
 usecase "Vendors (read)" as Vendor
 usecase "Manage vendor / accounts / promotions" as Admin
 usecase "Receive / transfer / stock history" as Stock
 usecase "Quote / checkout / resolve / safe cancel" as Sale
 usecase "Invoice lookup / reprint" as Invoice
 usecase "Warranty lookup / claim intake" as Warranty
 usecase "Claim state transitions" as Claim
 usecase "Revenue / best sellers" as Report
 usecase "Low-stock report" as Low
}
M --> Auth
C --> Auth
W --> Auth
M --> Products
C --> Products
W --> Products
M --> Catalog
M --> Customer
C --> Customer
M --> Vendor
W --> Vendor
M --> Admin
M --> Stock
W --> Stock
M --> Sale
C --> Sale
M --> Invoice
C --> Invoice
M --> Warranty
C --> Warranty
M --> Claim
M --> Report
M --> Low
W --> Low
@enduml
