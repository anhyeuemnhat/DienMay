<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
 <modelVersion>4.0.0</modelVersion>
 <parent><groupId>vn.dienmay</groupId><artifactId>dienmay-parent</artifactId><version>3.0.0</version></parent>
<artifactId>backend-server</artifactId>
<dependencies><dependency><groupId>vn.dienmay</groupId><artifactId>common-dto</artifactId><version>${project.version}</version></dependency><dependency><groupId>com.microsoft.sqlserver</groupId><artifactId>mssql-jdbc</artifactId><version>13.6.0.jre11</version><scope>runtime</scope></dependency></dependencies>
<build><finalName>backend-server</finalName>
  <pluginManagement>
    <plugins>
      <!-- Eclipse m2e must not run distribution assembly during workspace builds.
           A normal Maven package still executes backend-runtime copy-dependencies. -->
      <plugin>
        <groupId>org.eclipse.m2e</groupId>
        <artifactId>lifecycle-mapping</artifactId>
        <version>1.0.0</version>
        <configuration>
          <lifecycleMappingMetadata>
            <pluginExecutions>
              <pluginExecution>
                <pluginExecutionFilter>
                  <groupId>org.apache.maven.plugins</groupId>
                  <artifactId>maven-dependency-plugin</artifactId>
                  <versionRange>[3.8.1,)</versionRange>
                  <goals><goal>copy-dependencies</goal></goals>
                </pluginExecutionFilter>
                <action><ignore /></action>
              </pluginExecution>
            </pluginExecutions>
          </lifecycleMappingMetadata>
        </configuration>
      </plugin>
    </plugins>
  </pluginManagement>
<plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><configuration><archive><manifest><mainClass>vn.dienmay.server.ServerMain</mainClass></manifest><manifestEntries><Class-Path>common-dto.jar ../backend-server/lib/mssql-jdbc-13.6.0.jre11.jar</Class-Path></manifestEntries></archive></configuration></plugin><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId>
      <executions><execution><id>backend-runtime</id><phase>package</phase><goals><goal>copy-dependencies</goal></goals>
      <configuration><includeScope>runtime</includeScope><outputDirectory>${project.basedir}/lib</outputDirectory></configuration>
      </execution></executions></plugin></plugins></build>
</project>
