<?xml version="1.0" encoding="UTF-8"?>
<project name="DienMay-Improved" default="verify" basedir=".">
  <description>Offline JDK 17+ build. Client and backend compile independently against common only.</description>
  <property name="release" value="17"/>
  <property name="build" location="build"/>
  <property name="evidence" location="docs/evidence"/>
  <property name="dist" location="dist"/>
  <path id="all.classes">
    <pathelement location="${build}/common"/><pathelement location="${build}/backend"/>
    <pathelement location="${build}/client"/><pathelement location="${build}/tests"/>
    <fileset dir="backend-server/lib" includes="*.jar"/>
  </path>
  <target name="init">
    <mkdir dir="${build}/common"/><mkdir dir="${build}/backend"/><mkdir dir="${build}/client"/>
    <mkdir dir="${build}/tests"/><mkdir dir="${build}/tools"/>
    <mkdir dir="${evidence}"/><mkdir dir="${dist}"/>
  </target>
  <target name="clean"><delete dir="${build}"/><delete dir="${dist}"/></target>
  <target name="tools" depends="init">
    <javac srcdir="tools/src/main/java" destdir="${build}/tools" release="${release}"
        encoding="UTF-8" includeantruntime="false" debug="true"/>
  </target>
  <target name="format" depends="tools">
    <java classname="vn.dienmay.tools.SourceStyle" fork="true" failonerror="true">
      <classpath path="${build}/tools"/><arg value="format"/><arg value="${basedir}"/>
    </java>
  </target>
  <target name="style" depends="tools">
    <java classname="vn.dienmay.tools.SourceStyle" fork="true" failonerror="true"
        output="${evidence}/style-check.log">
      <classpath path="${build}/tools"/><arg value="check"/><arg value="${basedir}"/>
    </java>
    <java classname="vn.dienmay.tools.SourceStyle" fork="true" failonerror="true"
        output="${evidence}/style-self-test.log">
      <classpath path="${build}/tools"/><arg value="self-test"/>
    </java>
    <echo>Project convention checks passed; see docs/evidence/style-check.log.</echo>
  </target>
  <target name="compile-common" depends="init">
    <javac srcdir="common-dto/src/main/java" destdir="${build}/common" release="${release}"
        encoding="UTF-8" includeantruntime="false" debug="true"><compilerarg value="-Xlint:all"/></javac>
  </target>
  <target name="compile-backend" depends="compile-common">
    <javac srcdir="backend-server/src/main/java" destdir="${build}/backend" release="${release}"
        encoding="UTF-8" includeantruntime="false" debug="true" classpath="${build}/common">
      <compilerarg value="-Xlint:all"/>
    </javac>
  </target>
  <target name="compile-client" depends="compile-common">
    <javac srcdir="client-swing/src/main/java" destdir="${build}/client" release="${release}"
        encoding="UTF-8" includeantruntime="false" debug="true" classpath="${build}/common">
      <compilerarg value="-Xlint:all"/>
    </javac>
    <copy todir="${build}/client">
      <fileset dir="client-swing/src/main/resources"/>
    </copy>
  </target>
  <target name="compile" depends="compile-backend,compile-client"/>
  <target name="compile-tests" depends="compile">
    <javac srcdir="tests/src/main/java" destdir="${build}/tests" release="${release}"
        encoding="UTF-8" includeantruntime="false" debug="true" classpathref="all.classes">
      <compilerarg value="-Xlint:all"/>
    </javac>
  </target>
  <macrodef name="offline-suite">
    <attribute name="class"/><attribute name="log"/>
    <sequential>
      <java classname="vn.dienmay.tests.@{class}" fork="true" failonerror="true"
          dir="${basedir}" output="${evidence}/@{log}">
        <classpath refid="all.classes"/>
        <jvmarg value="-Djava.awt.headless=true"/><jvmarg value="-Dfile.encoding=UTF-8"/>
        <jvmarg value="-Dstdout.encoding=UTF-8"/><jvmarg value="-Dstderr.encoding=UTF-8"/>
      </java>
      <echo>@{class}: passed (failures make this target fail). See docs/evidence/@{log}.</echo>
    </sequential>
  </macrodef>
  <target name="test" depends="compile-tests">
    <offline-suite class="UnitTests" log="unit-tests.log"/>
    <offline-suite class="ApiTests" log="api-tests.log"/>
    <offline-suite class="SecurityTests" log="security-tests.log"/>
    <offline-suite class="QualityTests" log="quality-tests.log"/>
  </target>
  <target name="sql-it" depends="compile-tests">
    <java classname="vn.dienmay.tests.SqlServerIT" fork="true" failonerror="true" dir="${basedir}">
      <classpath refid="all.classes"/><jvmarg value="-Djava.awt.headless=true"/>
      <jvmarg value="-Dstdout.encoding=UTF-8"/><jvmarg value="-Dstderr.encoding=UTF-8"/>
    </java>
  </target>
  <target name="ui" depends="compile-tests">
    <java classname="vn.dienmay.tests.UiSmoke" fork="true" failonerror="true" dir="${basedir}" timeout="120000">
      <classpath refid="all.classes"/><arg value="${evidence}/ui"/>
      <jvmarg value="-Dstdout.encoding=UTF-8"/><jvmarg value="-Dstderr.encoding=UTF-8"/>
    </java>
  </target>
  <target name="package" depends="compile">
    <jar destfile="${dist}/common-dto.jar" basedir="${build}/common"/>
    <jar destfile="${dist}/client-swing.jar" basedir="${build}/client">
      <manifest><attribute name="Main-Class" value="vn.dienmay.client.App"/>
        <attribute name="Class-Path" value="common-dto.jar"/></manifest>
    </jar>
    <jar destfile="${dist}/backend-server.jar" basedir="${build}/backend">
      <manifest><attribute name="Main-Class" value="vn.dienmay.server.ServerMain"/>
        <attribute name="Class-Path" value="common-dto.jar ../backend-server/lib/mssql-jdbc-13.6.0.jre11.jar"/>
      </manifest>
    </jar>
    <echo>Independent runtime artifacts are in dist/. SQL JDBC driver is in backend-server/lib; client has no database driver.</echo>
  </target>
  <target name="verify" depends="style,test,package"/>
</project>
